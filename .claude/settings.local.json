{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -File \"e:\\production\\meetwave-ai\\.claude\\auto-push.ps1\"",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Auto-pushing to GitHub..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(Get-ChildItem -Path \"e:\\\\production\\\\meetwave-ai\" -Force)",
      "Bash(Select-Object Name, PSIsContainer)",
      "Bash(grep -E \"\\\\.\\(md|json|yml|yaml|env|gitignore\\)$\")",
      "Skill(update-config)",
      "Skill(update-config:*)"
    ]
  }
}
